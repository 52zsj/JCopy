{
  "name": "jcopy",
  "private": true,
  "version": "0.9.3",
  "type": "module",
  "description": "跨平台轻量剪贴板共享工具",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
