    "app:build": "tauri build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "notes:section": "node scripts/changelog-section.mjs",
    "release:tag": "node scripts/release-tag.mjs",
    "dist:mac": "node scripts/build-all.mjs --mac",
    "dist:win": "node scripts/build-all.mjs --win",
    "dist:linux": "node scripts/build-all.mjs --linux",
    "dist:all": "node scripts/build-all.mjs --all"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
